<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build theo dung kieu Ultimate Tools (repo Etabs_Plugin, da chung minh
         nap duoc tren ETABS v22): .NET Framework 4.8 + ETABSv1.dll.
         Ban .NET 8 + CSiAPIv1 truoc day bi ETABS bao "Not Found" khi Add
         (duong dan dung, file dung, mo phong nap OK) — bo han, khong quay lai.
         (Doi 2026-11-08, theo quyet dinh cua user: giu DLL rieng, build kieu net48.) -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Code goc viet dung implicit usings (System, Collections.Generic,
         Linq...) — giu nguyen, khong phai them using tay vao tung file. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AssemblyName>EtabsLoadAssignerPlugin</AssemblyName>
    <RootNamespace>EtabsLoadAssigner.Plugin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EtabsLoadAssigner.Core\EtabsLoadAssigner.Core.csproj" />
    <!-- Thu vien API cua CSI: uu tien duong dan cai dat ETABS tren may
         (khong can copy DLL di dau) — neu may khong co ETABS thi roi ve
         ban copy trong lib/. Ca 2 truong hop deu Private=False:
         KHONG copy ETABSv1.dll ra output (ETABS da nap san API nay).
         EmbedInteropTypes=false giong Ultimate Tools. -->
    <Reference Include="ETABSv1" Condition="Exists('C:\Program Files\Computers and Structures\ETABS 22\ETABSv1.dll')">
      <HintPath>C:\Program Files\Computers and Structures\ETABS 22\ETABSv1.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
    <Reference Include="ETABSv1" Condition="!Exists('C:\Program Files\Computers and Structures\ETABS 22\ETABSv1.dll')">
      <HintPath>..\..\lib\ETABSv1.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
